{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autorepo",
  "version": "0.11.0",
  "identifier": "dev.sethjuarez.autorepo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:17420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Autorepo",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#ffffff",
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.githubusercontent.com; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.githubusercontent.com; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:17420 ws://127.0.0.1:17420; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../cli/packs/generic-starter": "packs/generic-starter"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVEODczQUNGNDBDNEQ1QTAKUldTZzFjUkF6enFIWFlSMUVmb2c4K29rR2lNWlgydFFKdVNybHcvbktBTlJNZWRvYmlmR29mMU4K",
      "endpoints": [
        "https://github.com/sethjuarez/autorepo/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
