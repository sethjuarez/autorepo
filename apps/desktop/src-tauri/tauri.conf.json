{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Autorepo",
  "version": "0.11.0",
  "identifier": "dev.sethjuarez.autorepo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:17420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Autorepo",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#ffffff",
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../cli/packs/generic-starter": "packs/generic-starter"
    }
  }
}
