{
  "app": "autorepo",
  "start": "npm --workspace apps/desktop run tauri -- dev",
  "readiness": {
    "frontend": true,
    "driveBridge": true,
    "timeoutSeconds": 180
  },
  "defaultDrill": "home-smoke",
  "drills": {
    "home-smoke": {
      "owned": true,
      "selector": ".home-workbench",
      "expectText": "Open a pack collection"
    }
  }
}
